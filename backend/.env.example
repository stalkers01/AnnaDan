# Application
SECRET_KEY=replace-with-a-unique-random-secret
ENVIRONMENT=development
DATABASE_URL=sqlite:///./annadan.db
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
FRONTEND_BASE_URL=http://127.0.0.1:5500

# Local defaults. Production deployment should enable email verification and safety review.
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_PHONE_VERIFICATION=false
REQUIRE_SAFETY_REVIEW=false
EXPOSE_OTP_IN_DEVELOPMENT=true

# Email notifications and email OTP (Resend)
RESEND_API_KEY=
EMAIL_FROM=Annadan <onboarding@resend.dev>

# SMS notifications and phone OTP (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Food image storage (Cloudinary)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=annadan/donations
UPLOAD_MAX_BYTES=5242880

# Voluntary platform support (Razorpay test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Docker Compose only
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
